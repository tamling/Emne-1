\begin{tikzpicture}[node distance=4mm]
  \node[box,text width=17mm] (a) {\textbf{Laptop}\\ \scriptsize src 192.168.10.40};
  \node[boxfill,text width=17mm,right=of a] (b) {\textbf{Gateway}\\ \scriptsize decides};
  \node[boxfill,text width=17mm,right=of b] (c) {\textbf{Provider}\\ \scriptsize decides};
